cat > .gitignore << 'EOF'
# Environment variables
.env
.env.local
.env.production
.env.development

# API keys & secrets
secrets.json
credentials.json

# macOS
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs
.vscode/
.idea/

# Node.js
node_modules/
package-lock.json

# Python
__pycache__/
*.pyc
venv/
.venv/

# n8n exports (optional)
*.sqlite

# Generated content
notes/processing/
notes/archive/

# Temporary files
tmp/
temp/
EOF