# ─── Google AI (Default — Free tier at aistudio.google.com) ──────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ─── Anthropic (Optional — switch any step to Claude) ─────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── OpenAI (Optional — switch any step to GPT) ───────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── Image Generation ─────────────────────────────────────────────────────────
# Provider: pollinations (free, no key) | stability (free tier, needs key)
IMAGE_PROVIDER=pollinations
# Pollinations model: flux | turbo | gptimage
POLLINATIONS_MODEL=flux
# Stability AI key (only needed if IMAGE_PROVIDER=stability)
STABILITY_API_KEY=your_stability_api_key_here
# Output dimensions
IMAGE_WIDTH=1400
IMAGE_HEIGHT=700

# ─── Cloudinary (Free tier: 25GB storage, 25GB bandwidth/month) ───────────────
# Get credentials at cloudinary.com — no credit card needed
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Medium Integration (Future — for auto-publishing) ────────────────────────
MEDIUM_INTEGRATION_TOKEN=your_medium_token_here
MEDIUM_AUTHOR_ID=your_medium_author_id_here
